#!/data/data/com.termux/files/usr/bin/bash
set -u

SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
    LINK_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
    LINK_TARGET="$(readlink "$SCRIPT_PATH")"
    case "$LINK_TARGET" in
        /*) SCRIPT_PATH="$LINK_TARGET" ;;
        *) SCRIPT_PATH="$LINK_DIR/$LINK_TARGET" ;;
    esac
done

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PREPARE="$ROOT_DIR/scripts/prepare_termux.sh"
SCANNER="$ROOT_DIR/bugreport_scanner_termux.py"

if [ ! -f "$SCANNER" ]; then
    printf '[HazzScreenS] ERRO: scanner não encontrado em %s\n' "$SCANNER" >&2
    exit 1
fi

if [ "${1:-}" = "trocar-key" ]; then
    rm -f "$HOME/.hazzscreens_license.json"
    shift
    printf '[HazzScreenS] Key removida deste aparelho. Informe a nova key para continuar.\n'
fi

if [ -f "$PREPARE" ]; then
    bash "$PREPARE" || exit 1
fi

PYTHON_BIN="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
if [ -z "$PYTHON_BIN" ]; then
    printf '[HazzScreenS] ERRO: Python não está disponível.\n' >&2
    exit 1
fi

exec "$PYTHON_BIN" "$SCANNER" "$@"
